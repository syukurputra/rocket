# === Template env PRODUKSI ===
# Salin ke .env.production DI SERVER lalu isi nilainya. JANGAN commit .env.production.

# --- Database (Postgres yang sudah ada) ---
# Kalau pakai pooler (mis. pgbouncer), DATABASE_URL = pooled, DIRECT_URL = koneksi langsung untuk migrate.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# --- Auth / JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Site ---
# Dipakai untuk link di email & redirect OAuth
NEXT_PUBLIC_SITE_URL=https://domain-produksi-kamu.com

# WAJIB diisi. Dipakai untuk returnUrl/notifyUrl iPaymu, sitemap, robots.txt,
# dan metadata. Kalau kosong, sebagian endpoint jatuh ke http://localhost:3000
# sehingga callback pembayaran iPaymu tidak pernah sampai.
NEXT_PUBLIC_APP_URL=https://domain-produksi-kamu.com

# --- Email (SMTP) ---
# Port 465 + SSL (lihat src/libs/mailer.ts)
MAIL_SERVER=
EMAIL_USER=
EMAIL_PASSWORD=

# Alamat & nama yang tampil di badan email. Ada nilai default kalau dikosongkan.
SUPPORT_EMAIL=notif@bantusewa.com
COMPANY_NAME=Bantu Sewa

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://domain-produksi-kamu.com/api/auth/google/callback

# --- Object Storage (Nevacloud S3) ---
S3_ENDPOINT=https://s3.nevaobjects.id
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# --- Payment (iPaymu) ---
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_ENV=production
