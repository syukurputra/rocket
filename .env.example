# Environment Example File
# Copy this to .env and fill in your actual values

# DATABASE
DATABASE_URL=postgres://username:password@host:5432/database?sslmode=require&pgbouncer=true&connect_timeout=10
DIRECT_URL=postgres://username:password@host:5432/database?sslmode=require&connect_timeout=10

# JWT SECRETS
JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-very-long-and-complex
JWT_REFRESH_SECRET=your-refresh-secret-key-also-make-this-very-long-and-complex

# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# EMAIL CONFIGURATION
MAIL_SERVER=smtp.example.com
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# NODE ENVIRONMENT
NODE_ENV=development
