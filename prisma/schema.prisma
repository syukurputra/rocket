generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id               String             @id @default(cuid())
  nama             String
  alamat           String?
  telepon          String?
  email            String?
  status           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  paketId          String?
  paketStartDate   DateTime?
  paketEndDate     DateTime?
  aset             Aset[]
  categoryKeuangan CategoryKeuangan[]
  paket            MasterPaket?       @relation("CompanyActivePaket", fields: [paketId], references: [id])
  keuangan         Keuangan[]
  penghuni         Penghuni[]
  roles            Role[]
  ruangan          Ruangan[]
  tagihan          Tagihan[]
  users            User[]

  @@map("company")
}

model Role {
  id        String     @id @default(cuid())
  nama      String
  deskripsi String?
  status    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  companyId String
  menuRoles MenuRole[]
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users     User[]

  @@map("role")
}

model MenuRole {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roleId    String
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@map("menu_role")
}

model Menu {
  id         String      @id @default(cuid())
  nama       String
  keterangan String?
  path       String?
  icon       String?
  urutan     Int         @default(0)
  parentId   String?
  status     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  parent     Menu?       @relation("MenuHierarchy", fields: [parentId], references: [id])
  children   Menu[]      @relation("MenuHierarchy")
  menuRoles  MenuRole[]
  paketMenus PaketMenu[]

  @@map("menu")
}

model User {
  id               String    @id @default(cuid()) @db.VarChar(100)
  username         String    @unique @db.VarChar(50)
  email            String    @unique @db.VarChar(191)
  nomorTelepon     String?   @db.VarChar(20)
  password         String?   @db.VarChar(191)
  tokenVersion     Int       @default(0)
  createdAt        DateTime  @default(now())
  verifikasi       Boolean   @default(false)
  status           Boolean   @default(true)
  updatedAt        DateTime  @updatedAt
  resetToken       String?   @db.VarChar(255)
  resetTokenExpiry DateTime?
  companyId        String?
  roleId           String?

  // Invitation fields
  invitationToken  String?   @unique @db.VarChar(255)
  invitationExpiry DateTime?
  invitedAt        DateTime?
  invitedById      String?

  asetCreated             Aset[]             @relation("CreatedBy")
  asetUpdated             Aset[]             @relation("UpdatedBy")
  categoryKeuanganCreated CategoryKeuangan[] @relation("CategoryKeuanganCreatedBy")
  categoryKeuanganUpdated CategoryKeuangan[] @relation("CategoryKeuanganUpdatedBy")
  keuanganCreated         Keuangan[]         @relation("KeuanganCreatedBy")
  keuanganUpdated         Keuangan[]         @relation("KeuanganUpdatedBy")
  iconCreated             MasterIcon[]       @relation("IconCreatedBy")
  iconUpdated             MasterIcon[]       @relation("IconUpdatedBy")
  penghuniCreated         Penghuni[]         @relation("PenghuniCreatedBy")
  penghuniUpdated         Penghuni[]         @relation("PenghuniUpdatedBy")
  ruanganCreated          Ruangan[]          @relation("RuanganCreatedBy")
  ruanganUpdated          Ruangan[]          @relation("RuanganUpdatedBy")
  tagihanCreated          Tagihan[]          @relation("TagihanCreatedBy")
  tagihanUpdated          Tagihan[]          @relation("TagihanUpdatedBy")
  company                 Company?           @relation(fields: [companyId], references: [id])
  role                    Role?              @relation(fields: [roleId], references: [id])

  // Self-relation for invitations
  invitedBy    User?  @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[] @relation("UserInvitations")

  @@index([username])
  @@index([email])
  @@index([companyId])
  @@index([roleId])
  @@index([invitationToken])
  @@map("user")
}

model Aset {
  id        String  @id @default(cuid())
  jenis     String
  nama      String
  deskripsi String?
  alamat    String
  kota      String
  provinsi  String

  kecamatan     String?
  kelurahan     String?
  latitude      Float?
  longitude     Float?
  status        String          @default("aktif")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  nominal       Decimal         @default(0) @db.Decimal(15, 2)
  createdById   String
  updatedById   String
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  createdBy     User            @relation("CreatedBy", fields: [createdById], references: [id])
  updatedBy     User            @relation("UpdatedBy", fields: [updatedById], references: [id])
  keuangan      Keuangan[]
  penghuni      Penghuni[]
  ruangan       Ruangan[]
  images        AsetImage[]
  fasilitasAset FasilitasAset[]

  @@index([companyId])
  @@map("aset")
}

model AsetImage {
  id        String   @id @default(cuid())
  filename  String
  filepath  String
  filesize  Int?
  mimetype  String?
  createdAt DateTime @default(now())
  asetId    String
  aset      Aset     @relation(fields: [asetId], references: [id], onDelete: Cascade)

  @@index([asetId])
  @@map("aset_image")
}

model FasilitasAset {
  id        String     @id @default(cuid())
  nama      String
  iconId    String
  asetId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  icon      MasterIcon @relation(fields: [iconId], references: [id])
  aset      Aset       @relation(fields: [asetId], references: [id], onDelete: Cascade)

  @@index([asetId])
  @@index([iconId])
  @@map("fasilitas_aset")
}

model Ruangan {
  id               String             @id @default(cuid())
  nama             String
  deskripsi        String?            @db.Text
  status           String             @default("tidak huni")
  nominal          Decimal            @default(0) @db.Decimal(15, 2)
  hargaHarian      Decimal            @default(0) @db.Decimal(15, 2)
  hargaBulanan     Decimal            @default(0) @db.Decimal(15, 2)
  hargaTahunan     Decimal            @default(0) @db.Decimal(15, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdById      String
  updatedById      String
  companyId        String
  asetId           String
  penghuni         Penghuni[]
  aset             Aset               @relation(fields: [asetId], references: [id])
  company          Company            @relation(fields: [companyId], references: [id])
  createdBy        User               @relation("RuanganCreatedBy", fields: [createdById], references: [id])
  updatedBy        User               @relation("RuanganUpdatedBy", fields: [updatedById], references: [id])
  images           RuanganImage[]
  fasilitasRuangan FasilitasRuangan[]

  @@index([companyId])
  @@map("ruangan")
}

model RuanganImage {
  id        String   @id @default(cuid())
  filename  String
  filepath  String
  filesize  Int?
  mimetype  String?
  createdAt DateTime @default(now())
  ruanganId String
  ruangan   Ruangan  @relation(fields: [ruanganId], references: [id], onDelete: Cascade)

  @@index([ruanganId])
  @@map("ruangan_image")
}

model FasilitasRuangan {
  id        String     @id @default(cuid())
  nama      String
  iconId    String
  ruanganId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  icon      MasterIcon @relation(fields: [iconId], references: [id])
  ruangan   Ruangan    @relation(fields: [ruanganId], references: [id], onDelete: Cascade)

  @@index([ruanganId])
  @@index([iconId])
  @@map("fasilitas_ruangan")
}

model MasterIcon {
  id               String             @id @default(cuid())
  nama             String
  code             String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdById      String
  updatedById      String
  categoryKeuangan CategoryKeuangan[]
  fasilitasAset    FasilitasAset[]
  fasilitasRuangan FasilitasRuangan[]
  createdBy        User               @relation("IconCreatedBy", fields: [createdById], references: [id])
  updatedBy        User               @relation("IconUpdatedBy", fields: [updatedById], references: [id])

  @@map("m_icon")
}

model MasterPaket {
  id         String      @id @default(cuid())
  nama       String
  deskripsi  String?
  harga      Decimal     @db.Decimal(15, 2)
  durasi     Int         @default(1)
  status     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  companies  Company[]   @relation("CompanyActivePaket")
  paketMenus PaketMenu[]

  @@map("m_paket")
}

model PaketMenu {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  paketId   String
  menuId    String
  menu      Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  paket     MasterPaket @relation(fields: [paketId], references: [id], onDelete: Cascade)

  @@unique([paketId, menuId])
  @@map("paket_menu")
}

model Keuangan {
  id                 String           @id @default(cuid())
  jenis              String
  keterangan         String
  tanggal            DateTime         @default(now())
  nominal            Decimal          @db.Decimal(15, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdById        String
  updatedById        String
  companyId          String
  asetId             String
  categoryKeuanganId String
  aset               Aset             @relation(fields: [asetId], references: [id])
  categoryKeuangan   CategoryKeuangan @relation(fields: [categoryKeuanganId], references: [id])
  company            Company          @relation(fields: [companyId], references: [id])
  createdBy          User             @relation("KeuanganCreatedBy", fields: [createdById], references: [id])
  updatedBy          User             @relation("KeuanganUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId])
  @@map("keuangan")
}

model Penghuni {
  id           String    @id @default(cuid())
  nama         String
  email        String?   @db.VarChar(191)
  nomorTelepon String?   @db.VarChar(20)
  status       String    @default("KOSONG")
  periodeSewa  String?   @db.VarChar(20)
  mulaiHuni    DateTime  @default(now())
  selesaiHuni  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String
  updatedById  String
  companyId    String
  asetId       String
  ruanganId    String
  aset         Aset      @relation(fields: [asetId], references: [id])
  company      Company   @relation(fields: [companyId], references: [id])
  createdBy    User      @relation("PenghuniCreatedBy", fields: [createdById], references: [id])
  ruangan      Ruangan   @relation(fields: [ruanganId], references: [id])
  updatedBy    User      @relation("PenghuniUpdatedBy", fields: [updatedById], references: [id])
  tagihan      Tagihan[]

  @@index([companyId])
  @@map("penghuni")
}

model Tagihan {
  id              String   @id @default(cuid())
  keterangan      String
  status          String   @default("BELUM TERBAYAR")
  metodeBayar     String?
  mulaiSewa       DateTime @default(now())
  selesaiSewa     DateTime @default(now())
  nominal         Decimal  @default(0) @db.Decimal(15, 2)
  buktiPembayaran String?

  // Midtrans payment fields
  midtransOrderId           String?   @unique
  midtransTransactionId     String?
  midtransTransactionStatus String?
  midtransPaymentType       String?
  midtransTransactionTime   DateTime?
  paymentUrl                String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  updatedById String
  companyId   String
  penghuniId  String
  company     Company  @relation(fields: [companyId], references: [id])
  createdBy   User     @relation("TagihanCreatedBy", fields: [createdById], references: [id])
  penghuni    Penghuni @relation(fields: [penghuniId], references: [id])
  updatedBy   User     @relation("TagihanUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId])
  @@index([midtransOrderId])
  @@map("tagihan")
}

model CategoryKeuangan {
  id          String      @id @default(cuid())
  nama        String
  jenis       String
  deskripsi   String?
  color       String?
  status      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String
  updatedById String
  companyId   String
  iconId      String?
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("CategoryKeuanganCreatedBy", fields: [createdById], references: [id])
  icon        MasterIcon? @relation(fields: [iconId], references: [id])
  updatedBy   User        @relation("CategoryKeuanganUpdatedBy", fields: [updatedById], references: [id])
  keuangan    Keuangan[]

  @@index([companyId])
  @@map("category_keuangan")
}

// Master Data Wilayah
model MasterProvinsi {
  id        String       @id
  name      String
  kota      MasterKota[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("master_provinsi")
}

model MasterKota {
  id         String            @id
  provinceId String
  name       String
  provinsi   MasterProvinsi    @relation(fields: [provinceId], references: [id])
  kecamatan  MasterKecamatan[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([provinceId])
  @@map("master_kota")
}

model MasterKecamatan {
  id        String            @id
  cityId    String
  name      String
  kota      MasterKota        @relation(fields: [cityId], references: [id])
  kelurahan MasterKelurahan[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([cityId])
  @@map("master_kecamatan")
}

model MasterKelurahan {
  id         String          @id
  districtId String
  name       String
  kecamatan  MasterKecamatan @relation(fields: [districtId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([districtId])
  @@map("master_kelurahan")
}

// Scheduler Logs
model SchedulerLog {
  id          String   @id @default(cuid())
  jobName     String
  status      String   // 'started', 'success', 'failed'
  startedAt   DateTime @default(now())
  completedAt DateTime?
  duration    Int?     // Duration in milliseconds
  errorMessage String?  @db.Text
  errorStack   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([jobName])
  @@index([status])
  @@index([startedAt])
  @@map("scheduler_log")
}

