generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id               String             @id @default(cuid())
  nama             String
  alamat           String?
  telepon          String?
  email            String?
  status           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  paketId          String?
  paketStartDate   DateTime?
  paketEndDate     DateTime?
  isTrial          Boolean   @default(false)
  aset             Aset[]
  categoryKeuangan CategoryKeuangan[]
  paket            MasterPaket?       @relation("CompanyActivePaket", fields: [paketId], references: [id])
  invoices         Invoice[]          @relation("CompanyInvoices")
  keuangan         Keuangan[]
  pendapatan       Pendapatan[]
  penyewa          Penyewa[]
  roles            Role[]
  ruangan          Ruangan[]
  tagihan          Tagihan[]
  users            User[]

  @@map("company")
}

model Role {
  id        String     @id @default(cuid())
  nama      String
  deskripsi String?
  status    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  companyId String
  menuRoles MenuRole[]
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users     User[]

  @@map("role")
}

model MenuRole {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roleId    String
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@map("menu_role")
}

model Menu {
  id         String      @id @default(cuid())
  nama       String
  keterangan String?
  path       String?
  icon       String?
  urutan     Int         @default(0)
  parentId   String?
  status     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  parent     Menu?       @relation("MenuHierarchy", fields: [parentId], references: [id])
  children   Menu[]      @relation("MenuHierarchy")
  menuRoles  MenuRole[]
  paketMenus PaketMenu[]

  @@map("menu")
}

model User {
  id               String    @id @default(cuid()) @db.VarChar(100)
  username         String    @unique @db.VarChar(50)
  name             String?   @db.VarChar(100)
  email            String    @unique @db.VarChar(191)
  nomorTelepon     String?   @db.VarChar(20)
  nomorKtp         String?   @db.VarChar(50)
  alamat           String?   @db.Text
  provinsi         String?   @db.VarChar(100)
  kota             String?   @db.VarChar(100)
  kecamatan        String?   @db.VarChar(100)
  kelurahan        String?   @db.VarChar(100)
  latitude         Float?
  longitude        Float?
  photoUrl         String?   @db.VarChar(500)
  password         String?   @db.VarChar(191)
  tokenVersion     Int       @default(0)
  createdAt        DateTime  @default(now())
  verifikasi       Boolean   @default(false)
  status           Boolean   @default(true)
  updatedAt        DateTime  @updatedAt
  resetToken       String?   @db.VarChar(255)
  resetTokenExpiry DateTime?
  companyId        String?
  roleId           String?

  // Invitation fields
  invitationToken  String?   @unique @db.VarChar(255)
  invitationExpiry DateTime?
  invitedAt        DateTime?
  invitedById      String?

  asetCreated             Aset[]             @relation("CreatedBy")
  asetUpdated             Aset[]             @relation("UpdatedBy")
  categoryKeuanganCreated CategoryKeuangan[] @relation("CategoryKeuanganCreatedBy")
  categoryKeuanganUpdated CategoryKeuangan[] @relation("CategoryKeuanganUpdatedBy")
  keuanganCreated         Keuangan[]         @relation("KeuanganCreatedBy")
  keuanganUpdated         Keuangan[]         @relation("KeuanganUpdatedBy")
  iconCreated             MasterIcon[]       @relation("IconCreatedBy")
  iconUpdated             MasterIcon[]       @relation("IconUpdatedBy")
  penyewaCreated          Penyewa[]         @relation("PenyewaCreatedBy")
  penyewaUpdated          Penyewa[]         @relation("PenyewaUpdatedBy")
  ruanganCreated          Ruangan[]          @relation("RuanganCreatedBy")
  ruanganUpdated          Ruangan[]          @relation("RuanganUpdatedBy")
  tagihanCreated          Tagihan[]          @relation("TagihanCreatedBy")
  tagihanUpdated          Tagihan[]          @relation("TagihanUpdatedBy")
  company                 Company?           @relation(fields: [companyId], references: [id])
  role                    Role?              @relation(fields: [roleId], references: [id])
  invoicesCreated         Invoice[]          @relation("InvoiceCreatedBy")
  notifikasi              Notifikasi[]

  // Self-relation for invitations
  invitedBy    User?  @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[] @relation("UserInvitations")

  @@index([username])
  @@index([email])
  @@index([companyId])
  @@index([roleId])
  @@index([invitationToken])
  @@map("user")
}

model Aset {
  id        String  @id @default(cuid())
  jenis     String
  nama      String
  deskripsi String?
  alamat    String
  kota      String
  provinsi  String

  kecamatan     String?
  kelurahan     String?
  latitude      Float?
  longitude     Float?
  nomorWa          String?
  nomorWaAktif     Boolean         @default(false)
  instagram        String?
  instagramAktif   Boolean         @default(false)
  facebook         String?
  facebookAktif    Boolean         @default(false)
  status              String          @default("aktif")
  publishId           String?         @unique
  syaratKetentuan     String?         @db.Text
  bookingOnline       Boolean         @default(false)
  pembayaranOnline Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  nominal       Decimal         @default(0) @db.Decimal(15, 2)
  createdById   String
  updatedById   String
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  createdBy     User            @relation("CreatedBy", fields: [createdById], references: [id])
  updatedBy     User            @relation("UpdatedBy", fields: [updatedById], references: [id])
  keuangan      Keuangan[]
  tagihan       Tagihan[]
  ruangan       Ruangan[]
  images        AsetImage[]
  fasilitasAset FasilitasAset[]

  @@index([companyId])
  @@map("aset")
}

model AsetImage {
  id        String   @id @default(cuid())
  filename  String
  filepath  String
  filesize  Int?
  mimetype  String?
  createdAt DateTime @default(now())
  asetId    String
  aset      Aset     @relation(fields: [asetId], references: [id], onDelete: Cascade)

  @@index([asetId])
  @@map("aset_image")
}

model FasilitasAset {
  id        String     @id @default(cuid())
  nama      String
  iconId    String
  asetId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  icon      MasterIcon @relation(fields: [iconId], references: [id])
  aset      Aset       @relation(fields: [asetId], references: [id], onDelete: Cascade)

  @@index([asetId])
  @@index([iconId])
  @@map("fasilitas_aset")
}

model Ruangan {
  id               String             @id @default(cuid())
  nama             String
  deskripsi        String?            @db.Text
  status           String             @default("tidak huni")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdById      String
  updatedById      String
  companyId        String
  asetId           String
  tagihan          Tagihan[]
  aset             Aset               @relation(fields: [asetId], references: [id])
  company          Company            @relation(fields: [companyId], references: [id])
  createdBy        User               @relation("RuanganCreatedBy", fields: [createdById], references: [id])
  updatedBy        User               @relation("RuanganUpdatedBy", fields: [updatedById], references: [id])
  images           RuanganImage[]
  fasilitasRuangan FasilitasRuangan[]
  hargaItemAset    HargaItemAset[]

  @@index([companyId])
  @@map("item_aset")
}

model HargaItemAset {
  id         String   @id @default(cuid())
  jenisHarga String   // JAM | HARIAN | BULANAN | TAHUNAN
  harga      Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ruanganId  String
  ruangan    Ruangan  @relation(fields: [ruanganId], references: [id], onDelete: Cascade)

  @@index([ruanganId])
  @@map("harga_item_aset")
}

model RuanganImage {
  id        String   @id @default(cuid())
  filename  String
  filepath  String
  filesize  Int?
  mimetype  String?
  createdAt DateTime @default(now())
  ruanganId String
  ruangan   Ruangan  @relation(fields: [ruanganId], references: [id], onDelete: Cascade)

  @@index([ruanganId])
  @@map("item_aset_image")
}

model FasilitasRuangan {
  id        String     @id @default(cuid())
  nama      String
  iconId    String
  ruanganId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  icon      MasterIcon @relation(fields: [iconId], references: [id])
  ruangan   Ruangan    @relation(fields: [ruanganId], references: [id], onDelete: Cascade)

  @@index([ruanganId])
  @@index([iconId])
  @@map("fasilitas_item_aset")
}

model MasterIcon {
  id               String             @id @default(cuid())
  nama             String
  code             String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdById      String
  updatedById      String
  categoryKeuangan CategoryKeuangan[]
  fasilitasAset    FasilitasAset[]
  fasilitasRuangan FasilitasRuangan[]
  createdBy        User               @relation("IconCreatedBy", fields: [createdById], references: [id])
  updatedBy        User               @relation("IconUpdatedBy", fields: [updatedById], references: [id])

  @@map("m_icon")
}

model MasterJenisAset {
  id        String   @id @default(cuid())
  nama      String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("m_jenis_aset")
}

model MasterParameter {
  id        String   @id
  nama      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("m_parameter")
}

model MasterPaket {
  id           String      @id @default(cuid())
  nama         String
  deskripsi    String?
  iconUrl      String?
  hargaBulanan Decimal     @db.Decimal(15, 2)
  hargaTahunan Decimal     @db.Decimal(15, 2)
  urutan       Int         @default(0)
  status       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  companies    Company[]   @relation("CompanyActivePaket")
  paketMenus   PaketMenu[]
  invoices     Invoice[]   @relation("PaketInvoices")

  @@map("m_paket")
}

model Invoice {
  id              String      @id @default(cuid())
  nomorInvoice    String      @unique
  status          String      @default("PENDING") // PENDING | PAID | CANCELLED | EXPIRED
  billingCycle    String      @default("annually") // monthly | annually
  subtotal        Decimal     @db.Decimal(15, 2)
  pajak           Decimal     @default(0) @db.Decimal(15, 2)
  total           Decimal     @db.Decimal(15, 2)
  catatan         String?     @db.Text
  tanggalInvoice  DateTime    @default(now())
  tanggalJatuhTempo DateTime
  tanggalBayar    DateTime?
  buktiPembayaran String?
  
  // iPaymu fields
  ipaymuSessionId String?
  paymentUrl      String?

  // Rekonsiliasi fields (diisi saat proses rekon Excel)
  statusRekon      String?  // SESUAI | TIDAK_SESUAI
  amountPembayaran Decimal? @db.Decimal(15, 2)
  amountFee        Decimal? @db.Decimal(15, 2)
  typePembayaran   String?
  paymentChannel   String?
  paymentNo        String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  companyId       String
  paketId         String
  createdById     String
  company         Company     @relation("CompanyInvoices", fields: [companyId], references: [id])
  paket           MasterPaket @relation("PaketInvoices", fields: [paketId], references: [id])
  createdBy       User        @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([paketId])
  @@index([nomorInvoice])
  @@map("invoice")
}

model Notifikasi {
  id          String   @id @default(cuid())
  title       String
  subtitle    String   @db.Text
  avatarIcon  String?
  avatarColor String?
  type        String   // invoice | tagihan | penyewa | system
  url         String?  // redirect URL saat diklik
  refId       String?  // ID referensi ke record terkait
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@map("notifikasi")
}

model PaketMenu {
  id        String      @id @default(cuid())
  deskripsi String?
  tampilkan Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  paketId   String
  menuId    String
  menu      Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  paket     MasterPaket @relation(fields: [paketId], references: [id], onDelete: Cascade)

  @@unique([paketId, menuId])
  @@map("paket_menu")
}

model Keuangan {
  id                 String           @id @default(cuid())
  jenis              String
  keterangan         String
  tanggal            DateTime         @default(now())
  nominal            Decimal          @db.Decimal(15, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdById        String
  updatedById        String
  companyId          String
  asetId             String
  categoryKeuanganId String
  aset               Aset             @relation(fields: [asetId], references: [id])
  categoryKeuangan   CategoryKeuangan @relation(fields: [categoryKeuanganId], references: [id])
  company            Company          @relation(fields: [companyId], references: [id])
  createdBy          User             @relation("KeuanganCreatedBy", fields: [createdById], references: [id])
  updatedBy          User             @relation("KeuanganUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId])
  @@map("keuangan")
}

model Penyewa {
  id           String    @id @default(cuid())
  nama         String
  email        String?   @db.VarChar(191)
  nomorTelepon String?   @db.VarChar(20)
  nomorKtp     String?   @db.VarChar(20)
  alamat       String?
  provinsi     String?
  kota         String?
  kecamatan    String?
  kelurahan    String?
  latitude     Float?
  longitude    Float?
  status       String    @default("KOSONG")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String
  updatedById  String
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  createdBy    User      @relation("PenyewaCreatedBy", fields: [createdById], references: [id])
  updatedBy    User      @relation("PenyewaUpdatedBy", fields: [updatedById], references: [id])
  tagihan      Tagihan[]

  @@index([companyId])
  @@map("penyewa")
}

model Tagihan {
  id               String   @id @default(cuid())
  nomorTagihan     String?  @unique
  keterangan       String
  status           String   @default("BELUM TERBAYAR")
  metodeBayar      String?
  periodeSewa      String?  @db.VarChar(20)
  mulaiSewa        DateTime @default(now())
  selesaiSewa      DateTime @default(now())
  nominal          Decimal  @default(0) @db.Decimal(15, 2)
  adminBooking     Decimal  @default(0) @db.Decimal(15, 2)
  hargaMerchant    Decimal  @default(0) @db.Decimal(15, 2)
  buktiPembayaran  String?
  ipaymuSessionId  String?
  paymentUrl       String?  @db.Text

  // Rekonsiliasi fields
  statusRekon      String?
  amountPembayaran Decimal? @db.Decimal(15, 2)
  amountFee        Decimal? @db.Decimal(15, 2)
  typePembayaran   String?
  paymentChannel   String?
  paymentNo        String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String
  updatedById String
  companyId   String
  penyewaId   String
  asetId      String?
  ruanganId   String?
  company     Company     @relation(fields: [companyId], references: [id])
  createdBy   User        @relation("TagihanCreatedBy", fields: [createdById], references: [id])
  penyewa     Penyewa     @relation(fields: [penyewaId], references: [id])
  updatedBy   User        @relation("TagihanUpdatedBy", fields: [updatedById], references: [id])
  aset        Aset?       @relation(fields: [asetId], references: [id])
  ruangan     Ruangan?    @relation(fields: [ruanganId], references: [id])
  pendapatan  Pendapatan?

  @@index([companyId])
  @@map("tagihan")
}

model Pendapatan {
  id            String   @id @default(cuid())
  tagihanId     String   @unique
  companyId     String
  biayaBooking  Decimal  @db.Decimal(15, 2)
  biayaLayanan  Decimal  @default(0) @db.Decimal(15, 2)
  saldoCompany  Decimal  @db.Decimal(15, 2)
  tanggal       DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tagihan       Tagihan  @relation(fields: [tagihanId], references: [id])
  company       Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([tanggal])
  @@map("pendapatan")
}


model CategoryKeuangan {
  id          String      @id @default(cuid())
  nama        String
  jenis       String
  deskripsi   String?
  color       String?
  status      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String
  updatedById String
  companyId   String
  iconId      String?
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("CategoryKeuanganCreatedBy", fields: [createdById], references: [id])
  icon        MasterIcon? @relation(fields: [iconId], references: [id])
  updatedBy   User        @relation("CategoryKeuanganUpdatedBy", fields: [updatedById], references: [id])
  keuangan    Keuangan[]

  @@index([companyId])
  @@map("category_keuangan")
}

// Master Data Wilayah
model MasterProvinsi {
  id        String       @id
  name      String
  kota      MasterKota[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("master_provinsi")
}

model MasterKota {
  id         String            @id
  provinceId String
  name       String
  provinsi   MasterProvinsi    @relation(fields: [provinceId], references: [id])
  kecamatan  MasterKecamatan[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([provinceId])
  @@map("master_kota")
}

model MasterKecamatan {
  id        String            @id
  cityId    String
  name      String
  kota      MasterKota        @relation(fields: [cityId], references: [id])
  kelurahan MasterKelurahan[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([cityId])
  @@map("master_kecamatan")
}

model MasterKelurahan {
  id         String          @id
  districtId String
  name       String
  kecamatan  MasterKecamatan @relation(fields: [districtId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([districtId])
  @@map("master_kelurahan")
}

model BannerPromo {
  id           String   @id @default(cuid())
  judul        String
  deskripsi    String?  @db.Text
  imageUrl     String?
  periodeAwal  DateTime
  periodeAkhir DateTime
  status       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("banner_promo")
}

// Scheduler Logs
model SchedulerLog {
  id          String   @id @default(cuid())
  jobName     String
  status      String   // 'started', 'success', 'failed'
  startedAt   DateTime @default(now())
  completedAt DateTime?
  duration    Int?     // Duration in milliseconds
  errorMessage String?  @db.Text
  errorStack   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([jobName])
  @@index([status])
  @@index([startedAt])
  @@map("scheduler_log")
}

